# Test ortamı içindir. MAINNET İÇİN BU DOSYAYI KULLANMAYIN, aşağıdaki
# "Production / mainnet güvenlik notu" bölümüne bakın.

# Ajan cüzdanının private key'i, Sui CLI "suiprivkey..." (Bech32) formatında.
# `sui keytool export --key-identity <address>` ile alabilirsiniz.
AGENT_PRIVATE_KEY=suiprivkey1...

SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

PACKAGE_ID=0x0
MODULE_NAME=spending_cap
COIN_TYPE=0x2::sui::SUI

# Virgülle ayrılmış SpendingCap object ID listesi; agent yalnızca bunlar
# üzerinde execute_payment çağırır.
SPENDING_CAP_IDS=0xcap1,0xcap2

# Her bir cap için ne kadar ödenecek (base units, örn. SUI için 1_000_000_000 = 1 SUI).
PAYMENT_AMOUNT=1000000000

# Ödemenin gideceği adres (SpendingCap.allowed_recipient ile eşleşmeli).
RECIPIENT_ADDRESS=0x0

# Cron ifadesi, örn. her ayın 1'i saat 09:00 -> "0 9 1 * *"
CRON_SCHEDULE=0 9 1 * *

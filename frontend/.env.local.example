# Sui network to connect the frontend to.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Package ID returned by `sui client publish` for the move/ package.
NEXT_PUBLIC_PACKAGE_ID=0x0

# Coin type used for spending caps, e.g. 0x2::sui::SUI for testnet SUI,
# or the USDC coin type's <package>::<module>::<TYPE> on testnet.
NEXT_PUBLIC_COIN_TYPE=0x2::sui::SUI
